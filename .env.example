DEEPSEEK_API_KEY=sk-your-deepseek-key
# DASHSCOPE_API_KEY=sk-your-dashscope-key

# Anthropic-compatible relay providers: GLM/Kimi/MiniMax/MiMo/SiliconFlow/OpenRouter/custom.
# CSSWITCH_RELAY_KEY=sk-your-relay-key
# CSSWITCH_RELAY_BASE_URL=https://open.bigmodel.cn/api/anthropic
# CSSWITCH_RELAY_MODEL=glm-5.2
# CSSWITCH_RELAY_THINKING=adaptive

# OpenAI Chat Completions-compatible custom endpoint.
# CSSWITCH_OPENAI_KEY=sk-your-openai-compatible-key
# CSSWITCH_OPENAI_BASE_URL=https://example.com/v1
# CSSWITCH_OPENAI_MODEL=model-name
# Optional comma-separated model list exposed to Claude Science.
# CSSWITCH_OPENAI_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
# Optional fallback model ids used when the upstream rejects the first model.
# CSSWITCH_OPENAI_FALLBACK_MODELS=gpt-5.6-terra
